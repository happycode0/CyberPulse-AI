{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-health.schema.json",
  "title": "CyberPulse-AI source-health.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "counts", "sources", "pipeline", "discovery"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "name", "description", "publisher", "url", "region", "category", "beat",
          "lane", "priority", "expected_frequency", "enabled", "standing", "reputation",
          "lifecycle_state", "attention", "latest", "history"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "name": { "type": "string" },
          "description": {
            "description": "From config/sources.yaml; null only for a source the discovery gate added.",
            "type": ["string", "null"]
          },
          "publisher": {
            "description": "The organisation behind the feed, when the registry names one.",
            "type": ["string", "null"]
          },
          "url": { "type": "string" },
          "region": { "type": "string" },
          "category": { "type": "string" },
          "beat": { "anyOf": [{ "enum": ["cyber", "ai", "both"] }, { "type": "null" }] },
          "lane": { "enum": ["fast", "normal", "deep"] },
          "priority": { "type": "integer" },
          "expected_frequency": { "type": ["string", "null"] },
          "enabled": { "type": "boolean" },
          "standing": { "$ref": "#/$defs/standing" },
          "reputation": { "$ref": "#/$defs/reputation" },
          "lifecycle_state": {
            "enum": [
              "discovered", "candidate", "testing", "validated",
              "active", "degraded", "broken", "retired"
            ]
          },
          "attention": { "anyOf": [{ "$ref": "#/$defs/attention" }, { "type": "null" }] },
          "latest": { "anyOf": [{ "$ref": "#/$defs/check" }, { "type": "null" }] },
          "history": { "type": "array", "items": { "$ref": "#/$defs/check" } }
        }
      }
    },
    "pipeline": {
      "description": "Finds still at the discovery gate, furthest through first.",
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host", "state", "found_at", "reason"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "host": { "type": "string" },
          "state": { "enum": ["discovered", "candidate", "testing"] },
          "found_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      }
    },
    "discovery": {
      "description": "Where discovery stands: the discovered-source slots taken, what waits at the gate and why, and what the newest gate pass and search did (worker/publish/build.py `_discovery_summary`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active", "max_active", "ready_waiting", "testing", "queued", "homes_waiting",
        "at_the_gate", "shown", "rejected_total", "retired_total", "probes_to_activate",
        "max_open", "last_gate", "last_search", "recent"
      ],
      "properties": {
        "active": { "$ref": "#/$defs/count" },
        "max_active": { "$ref": "#/$defs/count" },
        "ready_waiting": { "$ref": "#/$defs/count" },
        "testing": { "$ref": "#/$defs/count" },
        "queued": { "$ref": "#/$defs/count" },
        "homes_waiting": { "$ref": "#/$defs/count" },
        "at_the_gate": { "$ref": "#/$defs/count" },
        "shown": { "$ref": "#/$defs/count" },
        "rejected_total": { "$ref": "#/$defs/count" },
        "retired_total": { "$ref": "#/$defs/count" },
        "probes_to_activate": { "$ref": "#/$defs/count" },
        "max_open": { "$ref": "#/$defs/count" },
        "last_gate": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["finished_at", "completed"],
              "properties": {
                "finished_at": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" },
                "probes": { "$ref": "#/$defs/count" },
                "healthy": { "$ref": "#/$defs/count" },
                "rejected": { "$ref": "#/$defs/count" },
                "activated": { "type": "array", "items": { "type": "string" } },
                "retired": { "type": "array", "items": { "type": "string" } },
                "pruned": { "type": "array", "items": { "type": "string" } },
                "waiting": { "$ref": "#/$defs/count" },
                "promoted": { "$ref": "#/$defs/count" }
              }
            },
            { "type": "null" }
          ]
        },
        "last_search": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["finished_at", "completed"],
              "properties": {
                "finished_at": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" },
                "searches": { "$ref": "#/$defs/count" },
                "new_hosts": { "$ref": "#/$defs/count" },
                "skipped": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "recent": {
          "description": "Finds activated or retired in the last 14 days, newest first.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "host", "state", "at", "found_by"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "host": { "type": "string" },
              "state": { "enum": ["active", "retired"] },
              "at": { "type": "string", "format": "date-time" },
              "found_by": { "enum": ["search", "tachikoma"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "standing": { "enum": ["authoritative", "established", "specialist", "community"] },
    "unit_share": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
    "reputation": {
      "description": "docs/wiki/importance-and-reputation.md",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "score", "standing", "uptime", "corroboration", "events_90d", "basis"
      ],
      "properties": {
        "version": { "type": "string" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "standing": { "$ref": "#/$defs/standing" },
        "uptime": { "$ref": "#/$defs/unit_share" },
        "corroboration": { "$ref": "#/$defs/unit_share" },
        "events_90d": { "type": "integer", "minimum": 0 },
        "basis": { "type": "string" }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "enum": ["fix", "watch", "coming", "blocked"] },
        "reason": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at", "status", "error", "newest_item_age_days", "items_fetched", "duration_ms"
      ],
      "properties": {
        "checked_at": { "type": "string", "format": "date-time" },
        "status": {
          "enum": ["ok", "error", "timeout", "empty", "stale", "degraded", "disabled"]
        },
        "error": { "type": ["string", "null"] },
        "newest_item_age_days": { "type": ["number", "null"] },
        "items_fetched": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
