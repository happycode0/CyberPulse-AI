{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live.schema.json",
  "title": "CyberPulse-AI live.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "last_completed_collection", "pipeline_version", "counts", "events"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "last_completed_collection": { "type": ["string", "null"], "format": "date-time" },
    "pipeline_version": { "type": "string" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "event.schema.json#/$defs/published_event" }
    }
  }
}
