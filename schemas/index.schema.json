{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "CyberPulse-AI index.json",
  "description": "History index: one entry per UTC date that has events, newest first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "pipeline_version", "latest", "days"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "pipeline_version": { "type": "string" },
    "latest": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "path", "event_count"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "path": { "type": "string", "pattern": "^history/\\d{4}-\\d{2}-\\d{2}\\.json$" },
          "event_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "merged": {
      "description": "Events merged into another: merged event id -> the event it joined.",
      "type": "object",
      "propertyNames": { "pattern": "^evt-\\d{4}-\\d{6}$" },
      "additionalProperties": { "type": "string", "pattern": "^evt-\\d{4}-\\d{6}$" }
    }
  }
}
