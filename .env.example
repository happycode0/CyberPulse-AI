# CyberPulse-AI environment
#
# Copy to .env and fill in. NEVER commit .env — it is git-ignored, and this
# repository is public.
#
#   cp .env.example .env && chmod 600 .env
#
# Verify everything works without printing any secret:
#
#   ./ops/check-keys.sh
#
# ═════════════════════════════════════════════════════════════════════════════
# STAGE 0 — fill these now. This is everything needed to collect and publish.
# ═════════════════════════════════════════════════════════════════════════════

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
#
# IMPORTANT, create a DEDICATED key for this project with a hard spend cap:
#   Name          cyberpulse-worker
#   Credit limit  20          <- the hard stop; the platform cannot exceed it
#   Limit reset   monthly
#
# One key covers inference, /benchmarks, /datasets/rankings-daily and
# /embeddings. Do NOT create a management key: the platform only reads
# GET /api/v1/key, so it never needs admin authority over your account.
OPENROUTER_API_KEY=

# Attribution headers sent on every call (public, not secret).
OPENROUTER_APP_TITLE=CyberPulse-AI
OPENROUTER_APP_URL=https://github.com/happycode0/CyberPulse-AI

# ─── Tavily ───────────────────────────────────────────────────────────────────
# https://app.tavily.com  — free tier is 1,000 credits/month, no card needed.
# Basic search = 1 credit. We pin search_depth=basic and cap the daily
# discovery lane at ~30 searches, so the free tier is sufficient.
TAVILY_API_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# https://github.com/settings/personal-access-tokens/new
# Fine-grained, scoped to happycode0/CyberPulse-AI ONLY, 90-day expiry.
#   Contents  Read and write     (push generated data)
#   Metadata  Read               (automatic)
# Also raises the GitHub Advisory API limit from 60 to 5,000 requests/hour.
CYBERPULSE_PUBLISH_TOKEN=
GITHUB_REPOSITORY=happycode0/CyberPulse-AI

# ─── NVD (optional but recommended) ──────────────────────────────────────────
# https://nvd.nist.gov/developers/request-an-api-key — free.
# Raises the rate limit from 5 to 50 requests per 30 seconds.
# Leaving this blank is fine: NVD now defers most new CVEs and authors almost
# no CVSS scores, so severity comes from the CNA record and CISA Vulnrichment.
NVD_API_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# The worker sends the daily digest (07:00 Sydney time) and an alert for each new event
# that is critical or known exploited and matters to Australia. With either value empty,
# nothing is sent.
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
# 3. docker compose up -d --force-recreate worker   (a restart keeps the old values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── PostgreSQL (local Docker Compose) ───────────────────────────────────────
# Generate a password:  openssl rand -hex 24   (hex: no / or + to break the database URL)
POSTGRES_USER=cyberpulse
POSTGRES_PASSWORD=
POSTGRES_DB=cyber_intel
DATABASE_URL=postgresql://cyberpulse:${POSTGRES_PASSWORD}@db:5432/cyber_intel

# ═════════════════════════════════════════════════════════════════════════════
# MODEL LADDER — not set here any more. It lives in config/models.yaml, which is
# versioned, so every machine runs the same ladder and a change shows in git.
# The US$1.00/M output ceiling is a constant in worker/ai/ladder.py, so raising
# it is a reviewed code change. The worker checks every model against
# OpenRouter's live routes when it starts; any breach turns the AI layer off.
# Check by hand:  python -m worker --check-models
# RIPPERDOC re-checks prices daily (PLAN.md 7.6) because they drift.
# ═════════════════════════════════════════════════════════════════════════════

# Monthly budget in USD. Drives the degradation tiers in PLAN.md 7.4.
AI_MONTHLY_BUDGET_USD=20

# ═════════════════════════════════════════════════════════════════════════════
# STAGE 4 — Paperclip control plane. Leave blank until you build the VM.
# ═════════════════════════════════════════════════════════════════════════════

# Generate each separately:  openssl rand -base64 32
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
# No fallback exists for this one; signed tool-action approvals fail without it.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Your NetBird address for the VM.
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
# Set true once you have claimed the instance.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# Both default to ON upstream; turn them off.
PAPERCLIP_TELEMETRY_DISABLED=1
PAPERCLIP_ANNOUNCEMENTS_ENABLED=false
PAPERCLIP_SECRETS_STRICT_MODE=true

# Opens the worker ops API's read endpoints (worker/ops_api.py) to the AI agents, which get it
# from the Paperclip server's environment. Blank or under 32 characters: reads stay closed and
# only the wakes answer. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CYBERPULSE_OPS_TOKEN=

# ═════════════════════════════════════════════════════════════════════════════
# STAGE 6 — WHEELJACK, the engineer agent. Leave blank until then.
# ═════════════════════════════════════════════════════════════════════════════

# Second fine-grained PAT, same repo, 90-day expiry:
#   Contents       Read and write
#   Pull requests  Read and write
# This is the ONLY credential WHEELJACK ever receives.
CYBERPULSE_ENGINEER_TOKEN=

# The watchdog fires the Incident routine in Paperclip through a webhook trigger (signing mode
# bearer). Paperclip shows the URL and secret once, when you add the trigger. Put
# http://server:3100 in front of the /api/routine-triggers/public/<id>/fire part, so the worker
# reaches it on the compose network. With either blank, incidents go to Telegram only.
# Steps: docs/runbooks/watchdog-incidents.md, "The Incident routine".
PAPERCLIP_INCIDENT_WEBHOOK_URL=
PAPERCLIP_INCIDENT_WEBHOOK_SECRET=
# Paperclip's health endpoint, probed with no credentials. Set it empty to stop the probe.
# WATCHDOG_PAPERCLIP_URL=http://server:3100/api/health

# The VM's own LAN address (a DHCP reservation keeps it stable). docker-compose.yml binds
# Paperclip's port to this address only — never 0.0.0.0, never a router port forward.
PAPERCLIP_BIND_ADDRESS=

# ═════════════════════════════════════════════════════════════════════════════
# Optional / disabled
# ═════════════════════════════════════════════════════════════════════════════

# X API stays disabled: pay-per-use pricing, and SKIPPED is a valid state.
X_API_KEY=
X_API_SECRET=

LOG_LEVEL=INFO
TZ=Australia/Sydney
