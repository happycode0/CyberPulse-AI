# ─── Secrets: never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
!site/assets/**/*.key
auth.json
master.key
decision-signing.key
secrets/
credentials.json
# SSH and certificate material: the VM key lives in ~/.ssh, but a copy dropped here must not ship.
id_rsa*
id_ecdsa*
id_ed25519*
*_ed25519
*_ed25519.pub
*_rsa
*.ppk
*.p12
*.pfx
*.jks
*.kdbx
.netrc
.npmrc
# Paperclip's home holds its master.key, agent JWT secret and embedded database.
.paperclip/
# Database dumps are the whole dataset, secrets columns included.
*.sql.gz
*.dump
backup/
backups/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Runtime data: regenerated, never authoritative in git ────────────────────
/data/
raw-cache/
*.sqlite
*.db
pgdata/
paperclip-data/

# ─── Logs and diagnostics ────────────────────────────────────────────────────
*.log
logs/
worker/logs/

# ─── Codex / agent workspaces ────────────────────────────────────────────────
.codex/
worktrees/
.worktrees/

# ─── OS and editor noise ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Local scratch ───────────────────────────────────────────────────────────
scratch/
tmp/
*.local
