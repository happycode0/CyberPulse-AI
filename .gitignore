# ─── Secrets: never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
!site/assets/**/*.key
auth.json
master.key
secrets/
credentials.json

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Runtime data: regenerated, never authoritative in git ────────────────────
/data/
raw-cache/
*.sqlite
*.db
pgdata/
paperclip-data/

# ─── Logs and diagnostics ────────────────────────────────────────────────────
*.log
logs/
worker/logs/

# ─── Codex / agent workspaces ────────────────────────────────────────────────
.codex/
worktrees/
.worktrees/

# ─── OS and editor noise ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Local scratch ───────────────────────────────────────────────────────────
scratch/
tmp/
*.local
